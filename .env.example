# Secrets and infrastructure only. Everything an operator tunes lives in settings.yaml.

PORT=3000
LOG_LEVEL=info

# GHL marketplace app credentials (Settings -> Apps -> your app)
GHL_APP_CLIENT_ID=
GHL_APP_CLIENT_SECRET=
# Optional. Only needed to decrypt the payload for a page embedded inside the GHL UI.
GHL_APP_SSO_KEY=
GHL_API_DOMAIN=https://services.leadconnectorhq.com

DATABASE_URL=postgres://postgres:postgres@localhost:5432/harness
# REDIS_URL=redis://localhost:6379

# At least one provider key is required; the failover chain needs all three.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

SETTINGS_PATH=./settings.yaml
