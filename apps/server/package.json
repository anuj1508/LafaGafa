{
  "name": "@harness/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "dev:cli": "tsx src/cli.ts",
    "trace": "tsx src/trace-cli.ts",
    "kb:ingest": "tsx src/kb-ingest.ts",
    "db:reset": "tsx src/db-reset.ts"
  },
  "dependencies": {
    "@harness/config": "workspace:*",
    "@harness/core": "workspace:*",
    "@harness/db": "workspace:*",
    "@harness/ghl": "workspace:*",
    "@harness/skills-ghl": "workspace:*",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
